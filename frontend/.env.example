# URL pública da API no Render.
# Exemplo: https://glossflow-api.onrender.com
VITE_API_URL="http://localhost:3333"

# Opcional para preview/homologação de um tenant específico.
# Em produção normal o tenant é resolvido pelo hostname/domínio em runtime.
VITE_SALON_SLUG=""

# Opcional: DSN pública do Sentry para monitorar erros do frontend.
VITE_SENTRY_DSN=""
