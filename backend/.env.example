# =============================================================================
# GlossFlow API - ambiente local/produção
# Copie este arquivo para .env e preencha com dados reais.
# Nunca versionar .env com credenciais reais.
# =============================================================================

# Banco MongoDB Atlas
DATABASE_URL="mongodb+srv://usuario:senha@cluster.mongodb.net/glossflow?retryWrites=true&w=majority"

PORT=3333
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3333"
APP_PUBLIC_URL="http://localhost:5173"

# Site white-label / multi-tenant
# Ex.: glossflow.com.br permite ana.glossflow.com.br, bella.glossflow.com.br etc.
PUBLIC_ROOT_DOMAIN=""
# Fallback usado no domínio de demonstração quando nenhum tenant é informado.
DEFAULT_PUBLIC_SALON_SLUG="glossflow"

# Segurança
JWT_SECRET="troque-por-uma-chave-forte-com-mais-de-32-caracteres"
RATE_LIMIT_PER_MINUTE=180
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Super Admin da plataforma
# O startup pode provisionar/garantir esse usuário de forma idempotente.
SUPER_ADMIN_NAME="Super Admin GlossFlow"
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# IA - Groq (principal)
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
# Fallback opcional OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# WhatsApp
# Providers suportados: twilio | meta | provider HTTP customizado.
# A configuração operacional atual usa Twilio.
WHATSAPP_PROVIDER="twilio"
WHATSAPP_DRY_RUN="true"
# DDI padrão aplicado quando o cliente informa somente DDD + número.
WHATSAPP_DEFAULT_COUNTRY_CODE="55"

# Twilio WhatsApp
# Nunca compartilhe TWILIO_AUTH_TOKEN em prints, logs ou commits.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# URL pública EXATA cadastrada em "When a message comes in" no Sandbox/Sender.
TWILIO_WEBHOOK_URL=""
# Callback de entrega. Se vazio, o backend deriva de TWILIO_WEBHOOK_URL ou PUBLIC_API_URL.
TWILIO_STATUS_CALLBACK_URL=""
# No Sandbox existe um sender compartilhado; associe-o ao tenant de QA.
# Se vazio, usa DEFAULT_PUBLIC_SALON_SLUG.
TWILIO_DEFAULT_SALON_SLUG=""
# Trial serve somente para QA e aceita o ContentSid fornecido pelo painel Try out WhatsApp.
TWILIO_TRIAL_MODE="false"
TWILIO_TRIAL_CONTENT_SID=""

# Meta WhatsApp Cloud API - provider alternativo, não necessário no fluxo Twilio.
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Templates/Contents Utility do provider ativo.
# Twilio em produção: use o ContentSid HX... do template correspondente.
# Meta: use o nome do template aprovado.
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"

# confirmação - corpo com 7 parâmetros, nesta ordem:
# {{1}} cliente | {{2}} serviço | {{3}} data/hora | {{4}} profissional |
# {{5}} antecedência mínima | {{6}} URL de gerenciamento | {{7}} salão
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMED=""

# cancelamento - corpo com 5 parâmetros:
# {{1}} cliente | {{2}} serviço | {{3}} data/hora | {{4}} profissional | {{5}} salão
WHATSAPP_TEMPLATE_APPOINTMENT_CANCELLED=""

# lembrete 24h - corpo com 6 parâmetros:
# {{1}} cliente | {{2}} salão | {{3}} serviço | {{4}} data/hora |
# {{5}} profissional | {{6}} antecedência mínima de cancelamento
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_24H=""

# lembrete 2h - corpo com 5 parâmetros:
# {{1}} cliente | {{2}} serviço | {{3}} data/hora | {{4}} profissional | {{5}} salão
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_2H=""

# Provider HTTP personalizado opcional
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Política da agenda
CLIENT_CANCELLATION_MIN_HOURS=12
BOOKING_SLOT_INTERVAL_MINUTES=30
APPOINTMENT_REMINDER_SCAN_MINUTES=10
BUSINESS_TIMEZONE="America/Sao_Paulo"
BUSINESS_TIMEZONE_OFFSET="-03:00"

# Pagamentos
PAYMENTS_DRY_RUN="true"
MERCADO_PAGO_ACCESS_TOKEN=""
DEFAULT_PAYER_EMAIL="cliente@example.com"
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_SUCCESS_URL="http://localhost:5173/sucesso"
STRIPE_CANCEL_URL="http://localhost:5173/cancelado"

# Observabilidade
SENTRY_DSN=""
VITE_SENTRY_DSN=""

# Integrações futuras/opcionais
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CLOUDINARY_URL=""
META_ACCESS_TOKEN=""

# Comercial
DEFAULT_SALON_ID=""
COMMERCIAL_NOTIFY_WHATSAPP_TO=""
AFFILIATE_COMMISSION_PERCENT=20
TRIAL_DAYS=7
