# Copie para .env.qa APENAS em um ambiente isolado de QA.
# Nunca reutilize DATABASE_URL de produção.

QA_TENANT_BOOTSTRAP_ENABLED=true
QA_ENVIRONMENT=qa
QA_CONFIRMATION=CREATE_ISOLATED_QA_TENANT
QA_DATABASE_NAME=glossflow-qa

# Se seu runtime QA usa NODE_ENV=production apenas por otimização de build,
# habilite conscientemente a linha abaixo. O banco ainda precisa passar pelo guard de nome.
# QA_ALLOW_NODE_ENV_PRODUCTION=true

DATABASE_URL=mongodb+srv://<usuario>:<senha>@<cluster>/<glossflow-qa>?retryWrites=true&w=majority

QA_TENANT_SLUG=glossflow-qa
QA_TENANT_NAME=GlossFlow QA
QA_PLAN_NAME=QA Internal
QA_ADMIN_NAME=GlossFlow QA Admin
QA_ADMIN_EMAIL=<email-qa-autorizado>
QA_ADMIN_PASSWORD=<senha-qa-com-12-ou-mais-caracteres>

# Valores fictícios e isolados; não usar números de clientes reais.
QA_PHONE=5500000000000
QA_WHATSAPP=5500000000000
QA_ADDRESS=Ambiente QA isolado
